# =============================================================================
# LeWM configuration  -  language: le
# -----------------------------------------------------------------------------
# This file is read once at startup from ~/.config/LeWM/config.le
# Every line is one directive. # starts a comment. Strings with spaces go in
# double quotes. Booleans are true / false. Nothing else to remember.
#
# Sections below are just comments for your eyes; the parser does not care
# about ordering. Change something, save, restart LeWM (or use the settings
# panel / `set` over the IPC socket for the live bits).
# =============================================================================


# --- Core --------------------------------------------------------------------
# The main modifier used by every keybinding below.
modkey "Alt"

# Gap between tiled windows, in pixels.
gap 6

# Draw server-side borders? LeWM keeps it simple: one pixel-ish frame.
border_width 2
border_color_active  "#d65d0e"
border_color_normal  "#282828"
border_color_urgent  "#cc241d"

# XWayland is off by default. Flip to true if you need X11 apps.
xwayland false

# Layout applied to fresh workspaces. Pick one:
#   tile     - single column of equal-height windows
#   grid     - N x M grid that fills the screen
#   dwindle  - recursive master/split, big window + shrinking rest
#   master   - a main window on the left with the rest stacked beside it
#   custom   - nothing is auto-placed; drag windows around by hand
# Both "layout default \"name\"" and "layout = \"name\"" work.
layout = "dwindle"


# --- Animations --------------------------------------------------------------
# This is what makes LeWM feel smooth instead of snappy-in-a-bad-way.
# Durations are in milliseconds. Easing names: linear, easeOutQuad,
# easeOutCubic, easeInOutCubic, easeOutBack.
animation enabled   true
animation open_ms   220
animation close_ms  160
animation move_ms   130
animation easing   "easeOutCubic"


# --- Settings panel ----------------------------------------------------------
# A built-in panel you can pop open with the `toggle_panel` IPC command or a
# keybinding. It is a live config surface: changes write straight back to this
# file. The geometry/colors live here.
panel enabled   true
panel position  "top"
panel height    28
panel bg       "#1d2021"
panel fg       "#ebdbb2"


# --- Startup -----------------------------------------------------------------
# Programs to launch once the compositor is up. Order is launch order.
startup "swaybg -m fill -i /usr/share/backgrounds/lewm.png"
startup "waybar"
startup "dunst"
startup "pipewire"
startup "xdg-desktop-portal-wlr"


# --- Keybindings -------------------------------------------------------------
# Format:  key "Combo" action [args...]
# Combo is the modifier sequence. Actions: exec, layout_next, layout "name",
# kill_focused, focus_next, focus_prev, focus_last, swap_focused, fullscreen,
# float, sticky, workspace "n", workspace_next, workspace_prev, toggle_panel,
# relayout, focus_output_next, focus_output_prev, resize_grow, resize_shrink.

# Launchers
key "mod+Enter"     exec "kitty"
key "mod+d"         exec "fuzzel"
key "mod+r"         exec "grim -g \"$(slurp)\""
key "mod+Shift+r"   exec "swaylock"

# Layout
key "mod+Space"     layout_next
key "mod+t"         layout "tile"
key "mod+g"         layout "grid"
key "mod+w"         layout "dwindle"
key "mod+m"         layout "master"
key "mod+c"         layout "custom"
key "mod+Return"    relayout

# Focus
key "mod+j"         focus_next
key "mod+k"         focus_prev
key "mod+Shift+j"   focus_prev
key "mod+Shift+k"   focus_next
key "mod+Tab"       focus_last
key "mod+Ctrl+Left"   focus_output_prev
key "mod+Ctrl+Right"  focus_output_next

# Workspaces
key "mod+Ctrl+Tab"        workspace_next
key "mod+Ctrl+Shift+Tab"  workspace_prev
key "mod+1"         workspace "1"
key "mod+2"         workspace "2"
key "mod+3"         workspace "3"
key "mod+4"         workspace "4"
key "mod+5"         workspace "5"
key "mod+6"         workspace "6"
key "mod+7"         workspace "7"
key "mod+8"         workspace "8"
key "mod+9"         workspace "9"
key "mod+Shift+1"   workspace "1"
key "mod+Shift+2"   workspace "2"
key "mod+Shift+3"   workspace "3"

# Window management
key "mod+Shift+q"   kill_focused
key "mod+f"         fullscreen
key "mod+Shift+f"   float
key "mod+Shift+t"   sticky
key "mod+Shift+s"   swap_focused
key "mod+Shift+Space" toggle_panel

# Master-layout ratio
key "mod+equal"   resize_grow
key "mod+minus"   resize_shrink


# --- Workspaces --------------------------------------------------------------
# First arg is the id used by the keybindings above, second is a label.
workspace "1" "term"
workspace "2" "web"
workspace "3" "code"
workspace "4" "chat"
workspace "5" "media"
workspace "6" "games"
workspace "7" "mail"
workspace "8" "files"
workspace "9" "misc"


# --- Rules -------------------------------------------------------------------
# Match a client by app_id and decide where it lands. Assign a workspace,
# whether it floats or starts fullscreen by default, and optionally force a
# layout for that workspace.
rule "firefox"          workspace "2" float false
rule "chromium"         workspace "2" float false
rule "org.mozilla.firefox" workspace "2" float false
rule "code"             workspace "3" float false
rule "emacs"            workspace "3" float false
rule "discord"          workspace "4" float false
rule "telegram"         workspace "4" float false
rule "spotify"          workspace "5" float false
rule "steam"            workspace "6" float true
rule "thunderbird"      workspace "7" float false
rule "nautilus"         workspace "8" float false
rule "pcmanfm"          workspace "8" float false
rule "pavucontrol"      workspace "9" float true
rule "org.telegram.desktop" workspace "4" float false
rule "mpv"              workspace "5" float true
